# ============================================================
# .env.template — Copy this file to .env and fill in your values
# Run: cp .env.template .env
# Never commit .env to git — only commit this template file
# ============================================================

# ── STEP 4: Gmail SMTP (blocked by Dyson network) ────────────
SENDER_EMAIL=your_gmail@gmail.com
SENDER_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RECEIVER_EMAIL=receiver@example.com

# ── STEP 5: Telegram Bot ─────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Send your bot any message, then open in browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find "chat" → "id" in the response
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── STEP 6: SendGrid Email ────────────────────────────────────
# 1. Sign up free at sendgrid.com (100 emails/day, no credit card)
# 2. Settings → API Keys → Create API Key (Full Access)
# 3. Settings → Sender Authentication → verify your sender email
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_SENDER_EMAIL=your_verified_sender@example.com
SENDGRID_RECEIVER_EMAIL=receiver@example.com

# ── STEP 7: Microsoft Teams Webhook ──────────────────────────
# 1. Open Teams → go to target channel
# 2. Click ... → Connectors → Incoming Webhook → Configure
# 3. Give it a name → Create → copy the Webhook URL
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/xxxxxxxx

# ── STEP 8: Outlook SMTP ─────────────────────────────────────
# 1. Use any existing Outlook / Hotmail account (outlook.com)
# 2. If login fails, go to outlook.com → Settings → Mail →
#    Sync email → enable SMTP AUTH
OUTLOOK_SENDER_EMAIL=your_email@outlook.com
OUTLOOK_PASSWORD=your_outlook_password
OUTLOOK_RECEIVER_EMAIL=receiver@example.com
